# RedstoneCore — configuración del entorno
#
# CÓMO USARLO EN CADA SERVIDOR/MÁQUINA:
#   cp env.example .env
#   nano .env                          # dejar la contraseña real en DB_PASS
#   chmod 640 .env                      (en el servidor; ver README_SECURITY)
#
# Este archivo (env.example) SÍ se versiona y va SIN secretos reales.
# El archivo .env NO se versiona (está en .gitignore).
#
# Precedencia: las variables ya definidas en el entorno del servidor (getenv)
# mandan; .env solo completa lo que falte. Si falta alguna clave obligatoria,
# conexion.php termina con error y NUNCA usa credenciales en texto plano.

# Host del servidor MySQL.
DB_HOST=localhost

# Nombre de la base de datos de RedstoneCore.
DB_NAME=redstonecore_db

# Usuario de MySQL con privilegios sobre la base de datos.
DB_USER=redstone_admin

# Contraseña de DB_USER. Es la ÚNICA clave secreta: aquí va vacía/ejemplo,
# la real se define únicamente en el .env de cada servidor.
DB_PASS=